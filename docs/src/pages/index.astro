---
import { Code } from "astro:components";
import logo from "../assets/logo.svg";
import serverGo from "../_snippets/server.go?raw";
import trpcTs from "../_snippets/trpc.ts?raw";
import zodTs from "../_snippets/zod.ts?raw";
import enumsTs from "../_snippets/enums.ts?raw";
import clientTs from "../_snippets/client.ts?raw";
import routerGo from "../_snippets/router.go?raw";

// Dark entry only: the landing is dark-only, so a light theme would emit
// --shiki-light custom properties that nothing reads.
const themes = { dark: "night-owl" } as const;
const githubUrl = "https://github.com/befabri/trpcgo";
const installCommand = "go get github.com/befabri/trpcgo@latest";
const pageTitle = "Go Backend for tRPC TypeScript Clients";
const siteTitle = "trpcgo";
const description =
    "Build Go (Golang) APIs that work with @trpc/client, React Query, and generated TypeScript AppRouter contracts.";

const ogImage = new URL("/og.png", Astro.site);
const ogImageAlt = "trpcgo — Go on the server. tRPC on the client.";
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#17181c" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.site} />
        <meta property="og:locale" content="en" />
        <meta property="og:site_name" content={siteTitle} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
        <link rel="canonical" href={Astro.site} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{pageTitle} | {siteTitle}</title>
    </head>
    <body>
        <header class="site-header">
            <a class="logo" href="/" aria-label="trpcgo home">
                <img src={logo.src} alt="" />
            </a>

            <nav aria-label="Main navigation">
                <a href="/docs/">Docs</a>
                <a href="/quick-start/">Quick start</a>
                <a href={githubUrl}>GitHub</a>
            </nav>
        </header>

        <main>
            <section class="hero" aria-labelledby="hero-title">
                <div class="hero-copy">
                    <h1 id="hero-title">Go on the server.<br />tRPC on the client.</h1>
                    <p class="lead">
                        trpcgo keeps your API server in Go and gives frontend teams typed tRPC calls,
                        generated AppRouter contracts, Zod schemas, and runtime enum values.
                    </p>

                    <div class="actions">
                        <a class="button primary" href="/quick-start/">
                            Quick start <span aria-hidden="true">→</span>
                        </a>
                        <a class="button secondary" href={githubUrl}>GitHub</a>
                    </div>
                </div>

                <div class="install">
                    <span class="install-label">Install</span>

                    <div class="install-line">
                        <code><span class="prompt" aria-hidden="true">$</span>{installCommand}</code>

                        <button type="button" class="copy" data-copy={installCommand}>
                            <span class="sr-only">Copy install command</span>
                            <svg
                                class="icon-copy"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true">
                                <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            <svg
                                class="icon-check"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true">
                                <path d="m20 6-11 11-5-5"></path>
                            </svg>
                        </button>
                        <span id="copy-status" class="sr-only" role="status" aria-live="polite"></span>
                    </div>
                </div>
            </section>

            <section class="contract" aria-label="From Go source to generated contract to TypeScript client">
                <div class="code-sequence">
                    <div class="code-example">
                        <div class="code-chrome"><span>server.go</span></div>
                        <Code
                            code={serverGo}
                            lang="go"
                            themes={themes}
                            defaultColor={false}
                            aria-label="Go source"
                        />
                    </div>

                    <div class="arrow" aria-hidden="true">→</div>

                    <div class="code-example">
                        <div class="code-chrome">
                            <span class="tag">gen/</span>
                            <div class="tabs" role="tablist" aria-label="Generated files">
                                <button
                                    type="button"
                                    role="tab"
                                    id="tab-trpc"
                                    aria-controls="panel-trpc"
                                    aria-selected="true">trpc.ts</button
                                >
                                <button
                                    type="button"
                                    role="tab"
                                    id="tab-zod"
                                    aria-controls="panel-zod"
                                    aria-selected="false"
                                    tabindex="-1">zod.ts</button
                                >
                                <button
                                    type="button"
                                    role="tab"
                                    id="tab-enums"
                                    aria-controls="panel-enums"
                                    aria-selected="false"
                                    tabindex="-1">enums.ts</button
                                >
                            </div>
                        </div>

                        <Code
                            code={trpcTs}
                            lang="ts"
                            themes={themes}
                            defaultColor={false}
                            id="panel-trpc"
                            role="tabpanel"
                            aria-labelledby="tab-trpc"
                            tabindex="0"
                        />

                        <Code
                            code={zodTs}
                            lang="ts"
                            themes={themes}
                            defaultColor={false}
                            id="panel-zod"
                            role="tabpanel"
                            aria-labelledby="tab-zod"
                            tabindex="0"
                            hidden
                        />

                        <Code
                            code={enumsTs}
                            lang="ts"
                            themes={themes}
                            defaultColor={false}
                            id="panel-enums"
                            role="tabpanel"
                            aria-labelledby="tab-enums"
                            tabindex="0"
                            hidden
                        />
                    </div>

                    <div class="arrow" aria-hidden="true">→</div>

                    <div class="code-example">
                        <div class="code-chrome"><span>client.ts</span></div>
                        <Code
                            code={clientTs}
                            lang="ts"
                            themes={themes}
                            defaultColor={false}
                            aria-label="TypeScript client"
                        />
                    </div>
                </div>
            </section>

            <section class="capabilities" aria-labelledby="capabilities-title">
                <div>
                    <h2 id="capabilities-title">The tRPC backend features you expect, in Go.</h2>
                    <p>
                        Built on plain Go (Golang) and <code>net/http</code>. No TypeScript server required.
                    </p>
                </div>

                <dl>
                    <div>
                        <dt>Typed procedures</dt>
                        <dd>
                            Go queries, mutations, and SSE subscriptions, with middleware, metadata, and
                            server-side callers.
                        </dd>
                    </div>
                    <div>
                        <dt>HTTP runtime</dt>
                        <dd>Batching, SSE subscriptions, CORS, trusted origins, and error formatting.</dd>
                    </div>
                    <div>
                        <dt>Frontend generation</dt>
                        <dd>
                            TypeScript <code>AppRouter</code> contracts, Zod schemas, runtime enums, and watch mode.
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="start" aria-labelledby="start-title">
                <div>
                    <h2 id="start-title">Start with your Go module.</h2>
                    <p>
                        Point the router at the files you want, register your Go procedures, and the
                        TypeScript client code is written for you.
                    </p>
                </div>

                <div>
                    <Code
                        code={routerGo}
                        lang="go"
                        themes={themes}
                        defaultColor={false}
                        aria-label="Router setup"
                    />
                    <a href="/quick-start/">Open the quick start →</a>
                </div>
            </section>
        </main>

        <footer>
            <span>trpcgo</span>
            <div>
                <a href="/docs/">Documentation</a>
                <a href={githubUrl}>GitHub</a>
            </div>
        </footer>

        <script>
            for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
                button.addEventListener("click", async () => {
                    const text = button.dataset.copy;
                    if (!text) return;
                    const status = document.getElementById("copy-status");
                    try {
                        await navigator.clipboard.writeText(text);
                        button.classList.add("copied");
                        if (status) status.textContent = "Copied";
                        setTimeout(() => {
                            button.classList.remove("copied");
                            if (status) status.textContent = "";
                        }, 2000);
                    } catch {
                        if (status) status.textContent = "Copy failed";
                    }
                });
            }

            for (const tablist of document.querySelectorAll('[role="tablist"]')) {
                const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

                const select = (index: number, focus = true) => {
                    tabs.forEach((tab, i) => {
                        const selected = i === index;
                        tab.setAttribute("aria-selected", String(selected));
                        tab.tabIndex = selected ? 0 : -1;
                        const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
                        if (panel) panel.hidden = !selected;
                    });
                    if (focus) tabs[index].focus();
                };

                tabs.forEach((tab, i) => {
                    tab.addEventListener("click", () => select(i, false));
                    tab.addEventListener("keydown", (event) => {
                        const offset = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
                        if (offset === 0) return;
                        event.preventDefault();
                        select((i + offset + tabs.length) % tabs.length);
                    });
                });
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", Arial,
            sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        color: hsl(224, 6%, 77%);
        background: hsl(224, 10%, 10%);
        /* The landing is dark-only; the docs keep Starlight's theme switcher. */
        color-scheme: dark;
        font-synthesis: none;
        --background: hsl(224, 10%, 10%);
        --heading: hsl(0, 0%, 100%);
        --text: hsl(224, 6%, 77%);
        --muted: hsl(224, 6%, 56%);
        --line: hsl(224, 14%, 16%);
        --line-light: hsl(224, 10%, 23%);
        --accent: hsl(224, 100%, 85%);
        --accent-text: hsl(224, 10%, 10%);
        --inline-code: hsl(224, 10%, 23%);
        --code: #23262f;
        --code-border: hsl(224, 10%, 23%);
        --code-text: #d6deeb;
        --success: #c5e478;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-size: 1rem;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
    }

    a {
        color: var(--accent);
        text-underline-offset: 0.16em;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
    }

    .site-header,
    main,
    footer {
        width: min(1280px, calc(100% - 48px));
        margin-inline: auto;
    }

    [hidden] {
        display: none !important;
    }

    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 80px;
        border-bottom: 1px solid var(--line);
    }

    .logo {
        display: inline-flex;
        text-decoration: none;
    }

    .logo img {
        display: block;
        width: 92px;
        height: auto;
    }

    nav,
    footer div {
        display: flex;
        align-items: center;
        gap: 28px;
    }

    nav a,
    footer a {
        font-size: 0.875rem;
    }

    nav a:hover,
    footer a:hover,
    .start a:hover {
        color: var(--heading);
    }

    h1,
    h2,
    p {
        margin-top: 0;
    }

    h1,
    h2 {
        color: var(--heading);
        font-weight: 600;
        line-height: 1.2;
    }

    /* Hero */

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 64px;
        align-items: center;
        padding: 96px 0 88px;
    }

    .hero h1 {
        margin-bottom: 24px;
        font-size: clamp(2rem, 1.05rem + 4vw, 3.25rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        text-wrap: balance;
    }

    .lead {
        max-width: 46ch;
        margin-bottom: 36px;
        font-size: 1.125rem;
        text-wrap: pretty;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    .button {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.45em;
        padding: 0.5rem 1.05rem;
        border-radius: 0.35rem;
        font-size: 0.9375rem;
        font-weight: 500;
        line-height: 1.4;
        text-decoration: none;
        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .button.primary {
        background: var(--accent);
        color: var(--accent-text);
    }

    .button.primary:hover {
        background: var(--heading);
    }

    .button.secondary {
        color: var(--accent);
    }

    .button.secondary::before {
        content: "";
        position: absolute;
        inset: 0;
        border: 1px solid currentColor;
        border-radius: inherit;
        opacity: 0.5;
        pointer-events: none;
    }

    .button.secondary:hover {
        background: color-mix(in srgb, currentColor 14%, transparent);
    }

    .install {
        min-width: 0;
        padding: 0.75rem;
        border: 1px solid var(--code-border);
        border-radius: 0.5rem;
        background: var(--code);
    }

    .install-label {
        display: block;
        margin-bottom: 0.7rem;
        color: var(--muted);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        line-height: 1;
        text-transform: uppercase;
    }

    .install-line {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .install-line code {
        flex: 1;
        min-width: 0;
        overflow-x: auto;
        color: var(--code-text);
        font-family: var(--mono);
        font-size: 0.9375rem;
        white-space: nowrap;
    }

    .install .prompt {
        margin-right: 0.6em;
        color: var(--muted);
        user-select: none;
    }

    .copy {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 1.85rem;
        height: 1.85rem;
        padding: 0;
        border: 0;
        border-radius: 0.25rem;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .copy:hover,
    .copy:focus-visible {
        background: color-mix(in srgb, currentColor 16%, transparent);
        color: var(--heading);
    }

    .copy svg {
        width: 0.9375rem;
        height: 0.9375rem;
    }

    .copy .icon-check,
    .copy.copied .icon-copy {
        display: none;
    }

    .copy.copied .icon-check {
        display: block;
        color: var(--success);
    }

    /* Sections */

    .contract,
    .capabilities,
    .start {
        padding: 80px 0;
        border-top: 1px solid var(--line);
    }

    h2 {
        margin-bottom: 0;
        font-size: 1.8125rem;
    }

    .capabilities > div > p,
    .start p {
        margin-bottom: 0;
    }

    /* Code sequence */

    .code-sequence {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: stretch;
        gap: 0.625rem;
    }

    .arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 0.875rem;
        color: var(--muted);
        font-size: 1rem;
        user-select: none;
    }

    .code-example {
        display: flex;
        flex-direction: column;
        min-width: 0;
        border: 1px solid var(--code-border);
        background: var(--code);
    }

    .code-chrome {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        padding: 0.35rem 0.75rem;
        border-bottom: 1px solid var(--code-border);
        color: var(--text);
        font-family: var(--mono);
        font-size: 0.75rem;
    }

    .code-chrome .tag {
        color: var(--muted);
    }

    .tabs {
        display: flex;
        align-items: center;
        gap: 0.125rem;
    }

    .tabs button {
        padding: 0.25rem 0.5rem;
        border: 0;
        border-radius: 0.25rem;
        background: transparent;
        color: var(--muted);
        font-family: inherit;
        font-size: inherit;
        line-height: 1.5;
        cursor: pointer;
        transition:
            background 0.15s ease,
            color 0.15s ease;
    }

    .tabs button:hover {
        color: var(--text);
    }

    .tabs button[aria-selected="true"] {
        background: color-mix(in srgb, var(--code-text) 12%, transparent);
        color: var(--heading);
    }

    pre {
        margin: 0;
        padding: 0.75rem;
        overflow-x: auto;
        background: var(--code);
        color: var(--code-text);
        font-family: var(--mono);
        font-size: 0.8125rem;
        font-weight: 400;
        line-height: 1.75;
        tab-size: 2;
    }

    .code-sequence pre {
        flex: 1;
        min-height: 27.5rem;
    }

    .code-sequence pre:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
    }

    .astro-code,
    .astro-code span {
        color: var(--shiki-dark);
    }

    /* Capabilities */

    .capabilities {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 90px;
    }

    .capabilities > div > p {
        margin-top: 18px;
    }

    .capabilities code {
        margin-block: -0.125rem;
        padding: 0.125rem 0.375rem;
        background: var(--inline-code);
        color: var(--heading);
        font-family: var(--mono);
        font-size: 0.8125rem;
    }

    dl {
        margin: 0;
    }

    dl > div {
        display: grid;
        grid-template-columns: 170px 1fr;
        gap: 28px;
        padding: 22px 0;
        border-top: 1px solid var(--line-light);
    }

    dl > div:last-child {
        border-bottom: 1px solid var(--line-light);
    }

    dt {
        color: var(--heading);
        font-weight: 600;
    }

    dd {
        margin: 0;
    }

    /* Start */

    .start {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: start;
    }

    .start > div {
        min-width: 0;
    }

    .start p {
        margin-top: 18px;
    }

    .start pre {
        margin-bottom: 18px;
        border: 1px solid var(--code-border);
        font-size: 0.8125rem;
    }

    footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 86px;
        border-top: 1px solid var(--line);
        font-size: 0.8125rem;
    }

    @media (max-width: 1080px) {
        .hero {
            grid-template-columns: 1fr;
            gap: 44px;
        }

        .install {
            max-width: 30rem;
        }

        .code-sequence {
            grid-template-columns: 1fr;
        }

        .arrow {
            width: auto;
            rotate: 90deg;
        }

        .code-sequence pre {
            min-height: 0;
            padding-bottom: 1.25rem;
        }
    }

    @media (max-width: 760px) {
        .site-header,
        main,
        footer {
            width: min(100% - 32px, 1100px);
        }

        .site-header {
            min-height: 68px;
        }

        .logo img {
            width: 82px;
        }

        nav {
            gap: 18px;
        }

        nav a:nth-child(2) {
            display: none;
        }

        .hero {
            padding: 64px 0 56px;
        }

        .lead {
            margin-bottom: 28px;
            font-size: 1.0625rem;
        }

        .install-line code {
            font-size: 0.8125rem;
        }

        .contract,
        .capabilities,
        .start {
            padding: 58px 0;
        }

        .capabilities,
        .start {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        dl > div {
            grid-template-columns: 1fr;
            gap: 6px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        * {
            transition-duration: 0.01ms !important;
        }
    }

</style>

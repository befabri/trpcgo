---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';

// Starlight emits twitter:card but no og:image, so social cards render blank
// without this. Regenerate the card with: node scripts/generate-og.mjs
const ogImage = new URL('/og.png', Astro.site);
---

<DefaultHead />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="trpcgo — Go on the server. tRPC on the client." />
<meta name="twitter:image" content={ogImage} />
<ClientRouter fallback="swap" />

<style is:global>
	.site-title img[src*='logo.svg'] {
		display: block;
		width: 2.75rem !important;
		height: 1.5rem !important;
		max-width: none;
		object-fit: contain;
	}
</style>
